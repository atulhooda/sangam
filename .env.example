# Copy to .env and fill in. Never commit .env.
#
# [YOU]    you create this value (account, key, API key)
# [SCRIPT] a setup script prints it; paste it in
# [OK]     default works, change only if needed

# ── Dev switches ────────────────────────────────────────────────
# Each mock shows a badge on the dashboard. Turn them all off for the real demo.
ENS_OFFLINE=true            # true: read merchants from data/merchants.local.json instead of ENS
OG_MOCK=true                # true: rule-based decision instead of 0G Compute
SKIP_CHAIN_VERIFY=false     # true: trust settlement notices without the Mirror Node check (simulated payments always skip it)
PSP_MODE=mock               # mock | razorpayx
DEMO_STEP_DELAY_MS=800      # pause between settlement steps so the dashboard can show each one; 0 for real use
ALLOW_SIMULATE=true         # false: hide the dashboard's simulate buttons and turn off /api/simulate
# HCS receipts switch on by themselves once HCS_TOPIC_ID and the OPERATOR_* key are set.

# ── Shared ──────────────────────────────────────────────────────
MERCHANT_ENS_NAME=tickets.sangam.eth          # [YOU] the ENS name you create; must match data/merchants.local.json while ENS_OFFLINE=true
SETTLEMENT_SHARED_SECRET=change-me            # [YOU] any random string: openssl rand -hex 32
SANGAM_API_URL=http://localhost:5173          # [OK] where the merchant sends settlement notices; the deployed URL once hosted
FX_API_URL=https://open.er-api.com/v6/latest/USD  # [OK] free USD→INR rate
FX_FALLBACK_INR_PER_USD=88                    # [OK] used if the rate API is down

# ── Hedera testnet (portal.hedera.com → create ECDSA accounts) ──
HEDERA_USDC_TOKEN_ID=0.0.429274               # [OK] testnet USDC (HEDERA_TESTNET_USDC in @x402/hedera)
FACILITATOR_URL=https://api.testnet.blocky402.com  # [OK] backups: https://x402.org/facilitator, https://testnet.facilitator.ax402.io
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com  # [OK]

# Buyer agent: holds USDC and pays merchants (the dashboard's "Pay as agent" button).
CUSTOMER_ACCOUNT_ID=                          # [YOU] 0.0.x
CUSTOMER_PRIVATE_KEY=                         # [YOU] ECDSA hex key
CUSTOMER_MAX_PER_PAYMENT=$1                   # [OK] SDK hard cap per payment
CUSTOMER_TOTAL_BUDGET=                        # [OK] cumulative USDC cap across all agent purchases, e.g. 25; blank = no cap

# Sangam treasury: receives USDC (it's the merchant's sangam.payTo).
# Its key is only used by npm run setup-hedera to associate USDC.
TREASURY_ACCOUNT_ID=                          # [YOU] 0.0.x
TREASURY_PRIVATE_KEY=                         # [YOU]

# Operator: pays for HCS receipts. Can be the same account as the treasury.
OPERATOR_ACCOUNT_ID=                          # [YOU] 0.0.x
OPERATOR_PRIVATE_KEY=                         # [YOU]
HCS_TOPIC_ID=                                 # [SCRIPT] npm run create-topic

# ── Self (identity: merchants & users verify with an Aadhaar QR) ──
# Both are read by the QR page AND the verifier (apps/web/lib/self-config.ts), and inlined at build time.
NEXT_PUBLIC_SELF_MOCK=true    # [OK] true: Self's staging network + test documents; false: real Aadhaar/passport (needs a public https URL)
NEXT_PUBLIC_SELF_ENDPOINT=    # [OK] blank = the page's own origin; in production set the public origin, e.g. https://sangam.up.railway.app
ALLOW_SELF_MOCK=              # [OK] a production build (next start) rejects mock proofs unless this is true
SESSION_SECRET=               # [YOU] signs sign-in cookies (30 days, renewed while used): openssl rand -hex 32. Blank = random per restart, which signs everyone out
# DEMO ONLY: username:password:ensName for Sangam's own demo shops, comma-separated. Blank turns /merchant/login off (404).
DEMO_MERCHANT_LOGINS=         # [YOU] e.g. railkart:<password>:tickets.sangam.eth,crumbs:<password>:bakery.sangam.eth

# ── 0G testnet (faucet.0g.ai) ───────────────────────────────────
OG_RPC_URL=https://evmrpc-testnet.0g.ai       # [OK] chain 16602
OG_PRIVATE_KEY=                               # [YOU] EVM key (0x…); can be the same key as ENS_OWNER_PRIVATE_KEY
OG_PROVIDER_ADDRESS=                          # [SCRIPT] pick one from: npm run setup-0g
OG_LEDGER_DEPOSIT=1                           # [OK] OG to put in the ledger (contract minimum 0.1)
OG_PROVIDER_FUND=0.5                          # [OK] OG moved to the provider (contract minimum 0.01)

# ── ENS (Sepolia, ENSv2): Sangam issues every merchant a subname ──
SEPOLIA_RPC_URL=                              # [OK] blank = viem's public Sepolia RPC; an Alchemy/Infura URL is more reliable
ENS_OWNER_PRIVATE_KEY=                        # [YOU] EVM key that owns ENS_PARENT_NAME (needs Sepolia ETH)
ENS_PARENT_NAME=sangam.eth                    # [YOU] register it at sepolia.app.ens.domains with that wallet
ENS_SANGAM_REGISTRY=                          # [SCRIPT] npm run setup-ens
ENS_SANGAM_RESOLVER=                          # [SCRIPT] npm run setup-ens

# ── RazorpayX test mode (only when PSP_MODE=razorpayx) ──────────
PSP_KEY_ID=                                   # [YOU] rzp_test_…
PSP_KEY_SECRET=                               # [YOU]
RAZORPAYX_ACCOUNT_NUMBER=                     # [YOU] RazorpayX test account number


# ── Bolo Sangam: voice invoices via Sarvam AI (api.sarvam.ai) ────
# Server-side only (route handlers); the browser never sees it. Leave blank
# and the Bolo panels simply don't appear.
SARVAM_API_KEY=                  # [YOU] from dashboard.sarvam.ai
SARVAM_STT_MODEL=saaras:v4       # [OK] speech-to-text; codemix mode for Hinglish
SARVAM_TTS_MODEL=bulbul:v4-flash # [OK] text-to-speech (Hindi confirmations)
SARVAM_LLM_MODEL=sarvam-105b     # [OK] transcript → invoice parse

# ── Bolo voice server (live Hindi conversations, Ritu-style) ─────
# A separate service (apps/bolo-voice) that the web app creates HMAC-signed
# sessions on; the browser streams audio to IT directly, and its signed
# callback turns confirmed speech into invoices. Blank = voice panels hidden.
BOLO_VOICE_URL=                 # [DEPLOY] e.g. https://bolo-voice-production.up.railway.app
BOLO_PUBLIC_API_URL=            # [DEPLOY] this web app's public URL (where the callback lands); blank = request origin won't work, set it explicitly
BOLO_SHARED_SECRET=             # [YOU] long random string, SAME value on the voice server
