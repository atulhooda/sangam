{
  "name": "sangam",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "node-forge": "1.3.1",
    "snarkjs": "0.7.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "npm --workspace @sangam/web run dev",
    "web": "npm --workspace @sangam/web run dev",
    "web:build": "npm --workspace @sangam/web run build",
    "build": "npm run web:build",
    "start": "npm --workspace @sangam/web run start",
    "gen-keys": "tsx scripts/gen-keys.ts",
    "setup-hedera": "tsx scripts/setup-hedera.ts",
    "create-topic": "tsx scripts/create-hcs-topic.ts",
    "setup-0g": "tsx scripts/setup-0g.ts",
    "simulate": "tsx scripts/simulate-settlement.ts",
    "setup-ens": "tsx scripts/setup-ens.ts",
    "add-merchant": "tsx scripts/add-merchant.ts",
    "register-parent": "tsx scripts/register-parent.ts",
    "buy-ondc": "tsx scripts/buy-ondc.ts",
    "mcp": "tsx packages/mcp/src/index.ts",
    "deploy-whitechain": "tsx scripts/deploy-whitechain.ts",
    "whitechain-ens": "tsx scripts/whitechain-ens.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "solc": "^0.8.26",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "^2.90.1",
    "dotenv": "^16.4.5",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  }
}
